# Desenvolvimento local: sem VITE_API_URL o frontend usa o proxy do Vite (/api -> 127.0.0.1:8000), sem CORS.
# Producao: a URL da API esta definida em .env.production (https://back-clop.onrender.com/api).
# O backend publico exige CORS configurado no Render (ver render.yaml).
# VITE_API_URL=https://back-clop.onrender.com/api
